+    // Apply a shader to one concrete window without affecting other windows
+    // that happen to share its class.
+    static void setWindowShader(const std::string& address, const std::string& path) {
+        uintptr_t rawAddress = 0;
+        try { rawAddress = std::stoull(address, nullptr, 0); } catch (...) { return; }
+        for (auto& window : Desktop::windowState()->windows()) {
+            if (!window || reinterpret_cast<uintptr_t>(window.get()) != rawAddress) continue;
+            auto* rawWindow = window.get();
+            if (path == "clear" || path == "none") {
+                g_mWindowManualShaders.erase(rawWindow);
+                g_mWindowShaderStarts.erase(rawWindow);
+            } else {
+                g_mWindowManualShaders[rawWindow] = path;
+                g_mWindowShaderStarts[rawWindow] = std::chrono::steady_clock::now();
+            }
+            g_pHyprRenderer->damageWindow(window);
+            return;
+        }
+    }
