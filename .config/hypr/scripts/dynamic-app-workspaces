#!/usr/bin/env bash

set -u

socket="$XDG_RUNTIME_DIR/hypr/$HYPRLAND_INSTANCE_SIGNATURE/.socket2.sock"
monitor_resolver="$HOME/.local/bin/orbit-monitor"
policy_resolver="$HOME/.local/bin/orbit-app-policy"
state_dir="${XDG_RUNTIME_DIR}/hypr-dynamic-workspaces"
mkdir -p "$state_dir"
lock_file="$state_dir/.lock"
daemon_lock="$state_dir/daemon.lock"
exec 8>"$daemon_lock"
flock -n 8 || exit 0

for state in "$state_dir"/*; do
    [[ "${state##*/}" == .lock || ! -f "$state" ]] && continue
    pid="${state##*/}"
    kill -0 "$pid" 2>/dev/null || rm -f "$state"
done

# These classes are routed by process ancestry. The first window from a
# process tree reserves a workspace; child windows stay with that instance.
client_json() {
    hyprctl clients -j 2>/dev/null
}

reserved_workspace() {
    "$monitor_resolver" workspace-for-monitor "$1" 2>/dev/null || true
}

reserved_anchor_class() {
    case "$1" in
        phleg-reserved-anchor-*|org.quickshell) return 0 ;;
        *) return 1 ;;
    esac
}

gaming_monitor() {
    "$monitor_resolver" resolve gaming 2>/dev/null || true
}

move_window_to_monitor() {
    local monitor="$1" address="$2" workspace
    workspace="$(hyprctl monitors -j 2>/dev/null | jq -r --arg monitor "$monitor" \
        'first(.[] | select(.name == $monitor) | .activeWorkspace.name) // empty')"
    [[ -n "$workspace" ]] || return 1
    hyprctl dispatch --quiet \
        "hl.dsp.window.move({ workspace = \"$workspace\", window = \"address:0x${address#0x}\" })" \
        >/dev/null 2>&1
}

monitor_name() {
    hyprctl monitors -j | jq -r --argjson index "$1" 'first(.[] | select(.id == $index) | .name) // empty'
}

find_workspace_for_pid() {
    local pid="$1" excluded_pattern="${2:-}" parent workspace state_class
    while [[ "$pid" =~ ^[0-9]+$ && "$pid" -gt 1 ]]; do
        workspace="$(awk -F= '$1 == "workspace" { print $2; exit }' "$state_dir/$pid" 2>/dev/null || true)"
        state_class="$(awk -F= '$1 == "class" { print $2; exit }' "$state_dir/$pid" 2>/dev/null || true)"
        if [[ -n "$workspace" && ( -z "$excluded_pattern" || ! "$state_class" =~ $excluded_pattern ) ]]; then
            printf '%s\n' "$workspace"
            return 0
        fi
        parent="$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d ' ')"
        [[ "$parent" =~ ^[0-9]+$ && "$parent" != "$pid" ]] || break
        pid="$parent"
    done
    return 1
}

active_application_workspace() {
    local address="$1"
    client_json | jq -r --arg address "0x${address#0x}" '
        [ .[]
          | select(.address != $address and .mapped and (.hidden | not))
          | select(.class != "org.quickshell")
          | select((.workspace.name // "") | startswith("special:") | not)
        ]
        | sort_by(.focusHistoryID)
        | first
        | .workspace.name // empty
    '
}

scan_floating_transitions() {
    local address class title floating xwayland workspace pin fullscreen policy_line monitor_role workspace_policy children_policy inherit_exclude marker previous
    while IFS=$'\t' read -r address class title floating xwayland workspace pin fullscreen; do
        [[ -n "$address" ]] || continue
        policy_line="$("$policy_resolver" resolve --class "$class" --title "$title" --floating "$floating" --xwayland "$xwayland" --workspace "$workspace" --pin "$pin" --fullscreen "$fullscreen" 2>/dev/null || true)"
        IFS=$'\t' read -r monitor_role workspace_policy children_policy inherit_exclude <<<"$policy_line"
        [[ "$workspace_policy" == "floating" ]] || continue
        marker="$state_dir/.floating-${address#0x}"
        previous=""
        [[ -f "$marker" ]] && read -r previous < "$marker"
        printf '%s\n' "$floating" > "$marker"
        [[ -n "$previous" && "$previous" != "$floating" ]] || continue
        route_window "$address" &
    done < <(client_json | jq -r '.[] | [.address, .class, .title, (.floating | tostring), (.xwayland | tostring), .workspace.name, (.pinned | tostring), (.fullscreen | tostring)] | @tsv')
}

route_window() {
    exec 9>"$lock_file"
    flock 9

    local address="$1" client class pid title floating xwayland pin fullscreen policy_line monitor_role workspace_policy children_policy inherit_exclude workspace="" current_workspace reserved monitor target_monitor moved_monitor=0
    for _ in {1..20}; do
        client="$(client_json | jq -c --arg address "0x${address#0x}" 'first(.[] | select(.address == $address)) // empty')"
        [[ -n "$client" ]] && break
        sleep 0.1
    done
    [[ -n "$client" ]] || return 0

    class="$(jq -r '.class' <<<"$client")"
    title="$(jq -r '.title' <<<"$client")"
    floating="$(jq -r '.floating' <<<"$client")"
    xwayland="$(jq -r '.xwayland' <<<"$client")"
    pin="$(jq -r '.pinned' <<<"$client")"
    fullscreen="$(jq -r '.fullscreen' <<<"$client")"
    pid="$(jq -r '.pid' <<<"$client")"
    "$HOME/.local/bin/orbit-app-observe" match --class "$class" --title "$title" >/dev/null 2>&1 || true
    current_workspace="$(jq -r '.workspace.name' <<<"$client")"
    monitor="$(monitor_name "$(jq -r '.monitor' <<<"$client")")"

    policy_line="$("$policy_resolver" resolve --class "$class" --title "$title" --floating "$floating" --xwayland "$xwayland" --workspace "$current_workspace" --pin "$pin" --fullscreen "$fullscreen" 2>/dev/null || true)"
    IFS=$'\t' read -r monitor_role workspace_policy children_policy inherit_exclude <<<"$policy_line"
    monitor_role="${monitor_role:-focused}"
    workspace_policy="${workspace_policy:-dedicated}"
    children_policy="${children_policy:-inherit}"
    inherit_exclude="${inherit_exclude:-}"

    [[ "$workspace_policy" == "ignore" ]] && return 0

    # Explicitly floating utilities belong to the workspace that launched
    # them. They are only allocated a workspace after becoming tiled.
    if [[ "$workspace_policy" == "floating" && "$floating" == "true" ]]; then
        return 0
    fi

    if [[ "$workspace_policy" == "transient" ]]; then
        workspace="$(active_application_workspace "$address")"
        [[ -n "$workspace" ]] || workspace="$current_workspace"
        if [[ -n "$workspace" && "$current_workspace" != "$workspace" ]]; then
            hyprctl dispatch --quiet \
                "hl.dsp.window.move({ workspace = \"$workspace\", window = \"address:0x${address#0x}\" })" \
                >/dev/null 2>&1 || true
        fi
        return 0
    fi

    if [[ "$monitor_role" == "gaming" ]]; then
        target_monitor="$(gaming_monitor)"
        if [[ -n "$target_monitor" && "$monitor" != "$target_monitor" ]]; then
            if move_window_to_monitor "$target_monitor" "$address"; then
                sleep 0.05
                client="$(client_json | jq -c --arg address "0x${address#0x}" 'first(.[] | select(.address == $address)) // empty')"
                [[ -n "$client" ]] || return 0
                current_workspace="$(jq -r '.workspace.name' <<<"$client")"
                monitor="$(monitor_name "$(jq -r '.monitor' <<<"$client")")"
                moved_monitor=1
            fi
        fi
    fi

    # A workspace recorded before a role-based monitor move is no longer a
    # valid owner for this client. Let the normal allocation path create a
    # workspace on the target monitor.
    [[ "$moved_monitor" -eq 1 ]] && rm -f "$state_dir/$pid"

    reserved="$(reserved_workspace "$monitor")"
    # Steam menus and notifications use the same class as the main client but
    # are transient floating surfaces. Their helper processes can have a
    # different PID, so correlate them with the visible non-floating Steam
    # window rather than requiring PID equality.
    if [[ "$class" == steam ]]; then
        if [[ "$(jq -r '.floating' <<<"$client")" == true ]]; then
            workspace="$(client_json | jq -r --argjson pid "$pid" \
                'first(.[] | select(.class == "steam" and (.floating | not) and .title == "Steam") | .workspace.name) // first(.[] | select(.class == "steam" and (.floating | not)) | .workspace.name) // empty')"
            if [[ -n "$workspace" && "$current_workspace" != "$workspace" ]]; then
                hyprctl dispatch --quiet \
                    "hl.dsp.window.move({ workspace = \"$workspace\", window = \"address:0x${address#0x}\" })" \
                    >/dev/null 2>&1
            fi
            return 0
        fi
    fi

    # Persistent landing workspaces are anchor-only. If a child process has a
    # known parent workspace, keep the child with its parent; otherwise send
    # the unexpected window to a fresh dynamic workspace. This applies to
    # unmanaged applications as well as the managed set below.
    if [[ -n "$reserved" && "$current_workspace" == "$reserved" ]] && ! reserved_anchor_class "$class"; then
        workspace="$(find_workspace_for_pid "$pid" || true)"
        if [[ -z "$workspace" || "$workspace" == "$reserved" ]]; then
            workspace="emptynm"
        fi
        hyprctl dispatch --quiet \
            "hl.dsp.window.move({ workspace = \"$workspace\", window = \"address:0x${address#0x}\" })" \
            >/dev/null 2>&1
        current_workspace="$(client_json | jq -r --arg address "0x${address#0x}" 'first(.[] | select(.address == $address) | .workspace.name) // empty')"
        workspace="$current_workspace"
        [[ "$class" == steam ]] && printf 'class=%s\nworkspace=%s\n' "$class" "$workspace" > "$state_dir/$pid"
    fi

    if [[ "$children_policy" == "inherit" ]]; then
        # A game excludes the Steam launcher state, while ordinary child
        # processes inherit the nearest application workspace.
        [[ -n "$workspace" ]] || workspace="$(find_workspace_for_pid "$pid" || true)"
        [[ -n "$inherit_exclude" ]] && workspace="$(find_workspace_for_pid "$pid" "$inherit_exclude" || true)"
    fi
    if [[ -z "$workspace" ]]; then
        hyprctl dispatch --quiet \
            "hl.dsp.window.move({ workspace = \"emptynm\", window = \"address:0x${address#0x}\" })" \
            >/dev/null 2>&1
        workspace="$(hyprctl clients -j | jq -r --arg address "0x${address#0x}" 'first(.[] | select(.address == $address) | .workspace.name) // empty')"
        [[ -n "$workspace" ]] || return 0
        printf 'class=%s\nworkspace=%s\n' "$class" "$workspace" > "$state_dir/$pid"
    elif [[ "$(jq -r '.workspace.name' <<<"$client")" != "$workspace" ]]; then
        hyprctl dispatch --quiet \
            "hl.dsp.window.move({ workspace = \"$workspace\", window = \"address:0x${address#0x}\" })" \
            >/dev/null 2>&1
    fi

    printf 'class=%s\nworkspace=%s\n' "$class" "$workspace" > "$state_dir/$pid"

}

cleanup() {
    local active monitor current target

    while IFS= read -r state; do
        [[ -f "$state" ]] || continue
        [[ "${state##*/}" == .lock ]] && continue
        pid="${state##*/}"
        kill -0 "$pid" 2>/dev/null || rm -f "$state"
    done < <(printf '%s\n' "$state_dir"/* 2>/dev/null)

    sleep 0.1
    active="$(hyprctl activeworkspace -j 2>/dev/null)" || return 0
    monitor="$(jq -r '.monitor' <<<"$active")"
    current="$(jq -r '.id' <<<"$active")"

    hyprctl clients -j 2>/dev/null | jq -e --argjson workspace "$current" \
        'any(.[]; .mapped and (.hidden | not) and .workspace.id == $workspace)' >/dev/null || {
        target="$(
            hyprctl workspaces -j 2>/dev/null |
                jq -r --arg monitor "$monitor" --argjson current "$current" '
                    [ .[]
                      | select(.monitor == $monitor and .windows > 0)
                      | {id, distance: ((.id - $current) | if . < 0 then - . else . end)}
                    ]
                    | sort_by([.distance, .id])
                    | first
                    | .id // empty
                '
        )"
        [[ -n "$target" ]] && hyprctl dispatch --quiet "hl.dsp.focus({ workspace = \"$target\" })" >/dev/null 2>&1
    }

}

while :; do
    [[ -S "$socket" ]] || { sleep 0.2; continue; }
    while IFS= read -r event; do
        case "$event" in
            openwindow\>*)
                address="${event#openwindow>>}"
                address="${address%%,*}"
                sleep 0.05
                route_window "$address" &
                ;;
            closewindow\>*) cleanup ;;
        esac
    done < <(timeout 0.5s socat -u "UNIX-CONNECT:$socket" - 2>/dev/null)
    scan_floating_transitions
    sleep 0.2
done
