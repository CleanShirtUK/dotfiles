#!/bin/sh

set -eu

direction=${1:-}
case "$direction" in
    u) step=-1; focus_direction=up ;;
    d) step=1; focus_direction=down ;;
    *) exit 2 ;;
esac

active=$(hyprctl activeworkspace -j)
workspace=$(printf '%s\n' "$active" | jq -r '.id')
monitor=$(printf '%s\n' "$active" | jq -r '.monitor')

# Hyprland's directional focus wraps at the edge. Check for a window in the
# requested direction first so the edge can transition to another workspace.
active_window=$(hyprctl activewindow -j)
clients=$(hyprctl clients -j)
has_window=$(jq -n \
    --arg direction "$focus_direction" \
    --argjson active "$active_window" \
    --argjson clients "$clients" '
    [$clients[]
        | select(.mapped and (.hidden | not))
        | select(.workspace.id == $active.workspace.id and .monitor == $active.monitor)
        | select(.address != $active.address)
        | ((.at[1] + (.size[1] / 2)) as $center
            | ($active.at[1] + ($active.size[1] / 2)) as $active_center
            | select(if $direction == "down" then $center > $active_center else $center < $active_center end))
    ] | length > 0')

if [ "$has_window" = true ]; then
    hyprctl dispatch --quiet "hl.dsp.focus({ direction = \"$focus_direction\" })"
    exit 0
fi

mapfile -t workspaces < <(
    hyprctl workspaces -j |
        jq -r --arg monitor "$monitor" '.[] | select(.monitor == $monitor) | .id' |
        sort -n
)

count=${#workspaces[@]}
[ "$count" -gt 0 ] || exit 0

index=0
for i in "${!workspaces[@]}"; do
    [ "${workspaces[$i]}" -eq "$workspace" ] && index="$i"
done

target_index=$((index + step))
[ "$target_index" -ge 0 ] || target_index=$((count - 1))
[ "$target_index" -lt "$count" ] || target_index=0
target="${workspaces[$target_index]}"

hyprctl dispatch --quiet "hl.dsp.focus({ workspace = \"$target\" })"
