#!/usr/bin/env bash

set -eu

direction=${1:-}
case "$direction" in
    u) step=-1 ;;
    d) step=1 ;;
    *) exit 2 ;;
esac

active=$(hyprctl activewindow -j)
workspace=$(printf '%s\n' "$active" | jq -r '.workspace.id')
monitor=$(hyprctl activeworkspace -j | jq -r '.monitor')

mapfile -t workspaces < <(
    hyprctl workspaces -j |
        jq -r --arg monitor "$monitor" '.[] | select(.monitor == $monitor) | .id' |
        sort -n
)

index=0
for i in "${!workspaces[@]}"; do
    [ "${workspaces[$i]}" -eq "$workspace" ] && index="$i"
done

target_index=$((index + step))
if [ "$target_index" -lt 0 ] || [ "$target_index" -ge "${#workspaces[@]}" ]; then
    hyprctl dispatch --quiet "hl.dsp.window.move({ workspace = \"emptynm\" })"
    exit 0
fi
target="${workspaces[$target_index]}"

hyprctl dispatch --quiet "hl.dsp.window.move({ workspace = $target })"
hyprctl dispatch --quiet "hl.dsp.focus({ workspace = \"$target\" })"
