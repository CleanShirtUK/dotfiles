#!/bin/sh

set -eu

monitor="${1:-reserved}"

while :; do
    clear
    printf '  PHLEG SESSION\n\n'
    printf '  reserved monitor: %s\n' "$monitor"
    printf '  %s\n' "$(date '+%A, %d %B %Y  %H:%M')"
    printf '  uptime: %s\n' "$(uptime -p 2>/dev/null || true)"
    printf '  load:   %s\n' "$(cut -d ' ' -f 1-3 /proc/loadavg 2>/dev/null || true)"
    printf '\n  This workspace is reserved for session transitions.\n'
    sleep 5
done
