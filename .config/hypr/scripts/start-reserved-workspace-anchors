#!/usr/bin/env bash
set -u

socket="${XDG_RUNTIME_DIR}/hypr/${HYPRLAND_INSTANCE_SIGNATURE:-}/.socket2.sock"
quickshell="$HOME/.local/bin/phleg-quickshell"
qml="$HOME/.config/hypr/scripts/reserved-workspace-xmb.qml"

anchor_address() {
    local title="$1"
    hyprctl clients -j 2>/dev/null |
        jq -r --arg title "$title" 'first(.[] | select(.class == "org.quickshell" and .title == $title) | .address) // empty'
}

ensure_fullscreen() {
    local address="$1"
    hyprctl clients -j 2>/dev/null |
        jq -e --arg address "$address" 'any(.[]; .address == $address and .fullscreen == 2)' >/dev/null && return 0

    hyprctl dispatch --quiet \
        "hl.dsp.window.fullscreen({ mode = \"fullscreen\", action = \"toggle\", window = \"address:$address\" })" \
        >/dev/null 2>&1 || true
}

start_anchor() {
    local title="$1" workspace="$2" monitor="$3" address
    address="$(anchor_address "$title")"
    if [[ -n "$address" ]]; then
        ensure_fullscreen "$address"
        return 0
    fi

    PHLEG_XMB_TITLE="$title" PHLEG_XMB_MONITOR="$monitor" \
        "$quickshell" --path "$qml" >/dev/null 2>&1 &

    for _ in {1..20}; do
        sleep 0.1
        address="$(anchor_address "$title")"
        [[ -n "$address" ]] || continue
        hyprctl dispatch --quiet \
            "hl.dsp.window.move({ workspace = \"$workspace\", window = \"address:$address\" })" \
            >/dev/null 2>&1 || true
        ensure_fullscreen "$address"
        return 0
    done
}

update_dock() {
    if hyprctl monitors -j 2>/dev/null |
        jq -e 'any(.[]; .activeWorkspace.name == "1" or .activeWorkspace.name == "6")' >/dev/null; then
        noctalia msg dock-hide >/dev/null 2>&1 || true
    else
        noctalia msg dock-show >/dev/null 2>&1 || true
    fi
}

ensure_anchors() {
    start_anchor phleg-xmb-dp1 1 DP-1
    start_anchor phleg-xmb-hdmi 6 HDMI-A-1
    update_dock
}

ensure_anchors
while :; do
    if [[ ! -S "$socket" ]]; then
        sleep 1
        ensure_anchors
        continue
    fi

    while IFS= read -r event; do
        case "$event" in
            closewindow\>\>*|workspace\>*|workspacev2\>*) ensure_anchors ;;
        esac
    done < <(socat -u "UNIX-CONNECT:$socket" 2>/dev/null)
    sleep 0.2
    ensure_anchors
done
