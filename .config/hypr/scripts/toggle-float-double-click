#!/usr/bin/env bash

set -euo pipefail

state_file="${XDG_RUNTIME_DIR}/hypr-double-click-float"
double_click_window=500
titlebar_height=20

window="$(hyprctl activewindow -j)"
cursor="$(hyprctl cursorpos -j)"

window_x="$(jq -r '.at[0]' <<<"$window")"
window_y="$(jq -r '.at[1]' <<<"$window")"
window_width="$(jq -r '.size[0]' <<<"$window")"
cursor_x="$(jq -r '.x' <<<"$cursor")"
cursor_y="$(jq -r '.y' <<<"$cursor")"

if ((cursor_x < window_x || cursor_x >= window_x + window_width || cursor_y < window_y || cursor_y >= window_y + titlebar_height)); then
    rm -f "$state_file"
    exit 0
fi

now="$(date +%s%3N)"
last="0"
if [[ -f "$state_file" ]]; then
    read -r last < "$state_file"
fi

if ((now - last <= double_click_window)); then
    rm -f "$state_file"
    hyprctl dispatch 'hl.dsp.window.float({ action = "toggle" })'
else
    printf '%s\n' "$now" > "$state_file"
fi
