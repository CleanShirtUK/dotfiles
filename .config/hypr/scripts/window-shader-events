#!/usr/bin/env bash

set -u

socket="$XDG_RUNTIME_DIR/hypr/$HYPRLAND_INSTANCE_SIGNATURE/.socket2.sock"
shader="$HOME/.config/hypr/shaders/window-ripple.glsl"
focus_shader="$HOME/.config/hypr/shaders/focus-ripple.glsl"
wezterm_shader="$HOME/.config/hypr/shaders/wezterm-ripple.glsl"
focus_wezterm_shader="$HOME/.config/hypr/shaders/focus-wezterm-ripple.glsl"
state_dir="${XDG_RUNTIME_DIR}/hypr-window-shader"
appearance_file="$HOME/.config/orbit/generated/appearance.json"
game_mode_flag="${XDG_RUNTIME_DIR}/hypr-game-mode.active"
lock_file="$state_dir/daemon.lock"
active_windows="$state_dir/active-windows"
focused_window="$state_dir/focused-window"
duration="2.0"
focus_duration="0.7"
open_delay="0.05"

mkdir -p "$state_dir"
exec 8>"$lock_file"
flock -n 8 || exit 0
: > "$active_windows"

excluded_class() {
    case "$1" in
        steam_app_*|Affinity|affinity|affinity.exe|resolve|Resolve|com.blackmagicdesign.resolve|darktable|Darktable|obs|OBS|com.obsproject.Studio|Inkscape|org.inkscape.Inkscape) return 0 ;;
        *) return 1 ;;
    esac
}

set_window_shader() {
    local address path lua_address lua_path command
    address="$1"
    path="$2"
    [[ -n "$address" ]] || return 0
    [[ "$path" == clear || ! -e "$game_mode_flag" ]] || return 0
    [[ "$address" == 0x* ]] || address="0x$address"
    lua_address="\"$address\""
    lua_path="\"$path\""
    command="hl.plugin.HyprWindowShade.togglewindowshader($lua_address, $lua_path)"
    hyprctl eval "$command" >/dev/null 2>&1 || true
}

shader_enabled() {
    [[ ! -f "$appearance_file" ]] || jq -e '.effects.hyprwindowshade_enabled == true' "$appearance_file" >/dev/null 2>&1
}

shader_for_class() {
    case "$1" in
        wezterm|WezTerm|org.wezfurlong.wezterm) printf '%s\n' "$wezterm_shader" ;;
        *) printf '%s\n' "$shader" ;;
    esac
}

remember_window() {
    local address="$1"
    grep -Fqx -- "$address" "$active_windows" 2>/dev/null || printf '%s\n' "$address" >> "$active_windows"
}

forget_window() {
    local address="$1" temporary
    temporary="$active_windows.tmp"
    while IFS= read -r remembered; do
        [[ "$remembered" == "$address" ]] || printf '%s\n' "$remembered"
    done < "$active_windows" > "$temporary" 2>/dev/null || true
    mv "$temporary" "$active_windows"
}

animate_window() {
    local address="$1" class="$2" effect_shader
    shader_enabled || return 0
    if grep -Fqx -- "$address" "$active_windows" 2>/dev/null; then
        return 0
    fi
    remember_window "$address"
    effect_shader="$(shader_for_class "$class")"
    sleep "$open_delay"
    # openwindow can arrive before the new client is present in the plugin's
    # window list. Wait for the address-targeted API to be able to find it.
    for _ in {1..20}; do
        if hyprctl -j clients 2>/dev/null | jq -e --arg address "0x${address#0x}" \
            '.[] | select(.address == $address)' >/dev/null; then
            break
        fi
        sleep 0.05
    done
    set_window_shader "$address" "$effect_shader"
    (
        sleep "$duration"
        set_window_shader "$address" clear
        forget_window "$address"
    ) &
}

clear_window() {
    local address="$1"
    [[ -n "$address" ]] && set_window_shader "$address" clear
    forget_window "$address"
}

animate_focus() {
    local address="$1" class="$2" previous generation effect_shader
    shader_enabled || return 0
    [[ -n "$address" ]] || return 0
    previous=""
    [[ -f "$focused_window" ]] && read -r previous _ < "$focused_window"
    [[ "$previous" == "$address" ]] && return 0
    [[ -n "$previous" && "$previous" != "$address" ]] && set_window_shader "$previous" clear
    # Let a newly opened window finish its spawn effect instead of replacing it.
    if grep -Fqx -- "$address" "$active_windows" 2>/dev/null; then
        return 0
    fi

    generation="$(date +%s%N)"
    printf '%s %s\n' "$address" "$generation" > "$focused_window"
    if excluded_class "$class"; then
        set_window_shader "$address" clear
        return 0
    fi

    effect_shader="$focus_shader"
    case "$class" in
        wezterm|WezTerm|org.wezfurlong.wezterm) effect_shader="$focus_wezterm_shader" ;;
    esac
    set_window_shader "$address" "$effect_shader"
    (
        sleep "$focus_duration"
        if [[ -f "$focused_window" ]] && read -r current current_generation < "$focused_window" &&
            [[ "$current" == "$address" && "$current_generation" == "$generation" ]]; then
            set_window_shader "$address" clear
        fi
    ) &
}

while :; do
    [[ -S "$socket" ]] || { sleep 0.2; continue; }
    while IFS= read -r event; do
        case "$event" in
            openwindow\>\>*)
                data="${event#openwindow>>}"
                IFS=',' read -r address _workspace class _title <<< "$data"
                event_class="$class"
                excluded_class "$class" || animate_window "$address" "$class"
                ;;
            closewindow\>\>*)
                clear_window "${event#closewindow>>}"
                ;;
            activewindow\>\>*)
                data="${event#activewindow>>}"
                IFS=',' read -r class _title <<< "$data"
                address="$(hyprctl -j activewindow 2>/dev/null | jq -r '.address // empty')"
                animate_focus "$address" "$class"
                ;;
            activewindowv2\>\>*)
                address="${event#activewindowv2>>}"
                [[ "$address" == 0x* ]] || address="0x$address"
                class="$(hyprctl -j clients 2>/dev/null | jq -r --arg address "$address" 'first(.[] | select(.address == $address) | .class) // empty')"
                animate_focus "$address" "$class"
                ;;
        esac
    done < <(socat -u "UNIX-CONNECT:$socket" - 2>/dev/null)
    sleep 0.2
done
