#!/usr/bin/env bash

set -euo pipefail

action="${1:-next}"
workspace_mru="${HOME}/.config/hypr/scripts/workspace-mru"
state_dir="${XDG_RUNTIME_DIR:-/tmp}/hypr-workspace-mru"

if [[ "$action" != --display-only ]]; then
    # Keep workspace navigation authoritative: this command is the existing
    # Alt+Tab implementation and must complete before the overlay is built.
    "$workspace_mru" "$action"
    # Commit MRU order immediately, while retaining the traversal snapshot so
    # rapid Alt+Tab presses continue through the whole cycle.
    "$workspace_mru" commit keep

    active="$(hyprctl activeworkspace -j)"
    monitor="$(jq -r '.monitor' <<<"$active")"
    safe_monitor="${monitor//[^A-Za-z0-9_.-]/_}"
    state_file="$state_dir/$safe_monitor.traversal"
    state_snapshot=""
    [[ -f "$state_file" ]] && state_snapshot="$(<"$state_file")"
    if [[ -n "$state_snapshot" ]]; then
        (
            sleep 0.45
            [[ -f "$state_file" && "$(<"$state_file")" == "$state_snapshot" ]] || exit 0
            rm -f "$state_file"
        ) >/dev/null 2>&1 &
    fi

    # Let fullscreen XWayland clients finish their focus transition before
    # querying state and showing the notification. This process is display-only
    # and must not remain in the Alt+Tab dispatch path.
    (
        sleep 0.05
        "${BASH_SOURCE[0]}" --display-only
    ) >/dev/null 2>&1 &
    exit 0
fi

active="$(hyprctl activeworkspace -j)"
monitor="$(jq -r '.monitor' <<<"$active")"
current="$(jq -r '.id' <<<"$active")"
safe_monitor="${monitor//[^A-Za-z0-9_.-]/_}"
state_file="$state_dir/$safe_monitor.traversal"

[[ -f "$state_file" ]] || exit 0
mapfile -t state < "$state_file"
history="${state[2]:-}"
[[ -n "$history" ]] || exit 0

declare -A titles
while IFS=$'\t' read -r workspace title; do
    [[ -n "$workspace" ]] || continue
    titles["$workspace"]+="${titles[$workspace]:+, }${title:-Untitled}"
done < <(
    hyprctl clients -j | jq -r '
        .[]
        | select(.mapped and (.hidden | not))
        | [.workspace.id, (.title // .class // "Untitled")]
        | @tsv
    '
)

message=$'Alt+Tab\n'
for workspace in $history; do
    marker="  "
    [[ "$workspace" == "$current" ]] && marker="> "
    message+="${marker}Workspace $workspace: ${titles[$workspace]:-Empty}\n"
done

# Native Hyprland notifications keep this lightweight and do not take focus or
# participate in workspace/window selection.
hyprctl notify 0 1400 "rgb(122,162,247)" "$message" >/dev/null 2>&1 || true
