# This is an allow-listed home dotfiles repository. Keep all unlisted home
# files ignored so credentials, caches, downloads, and application data cannot
# enter the repository accidentally.
*
!.gitignore
!README.md
!.config/
!.config/hypr/
!.config/hypr/**
!.config/hyprshell/
!.config/hyprshell/config.toml
!.config/hyprshell/styles.css
!.config/gtk-3.0/
!.config/gtk-3.0/gtk.css
!.config/gtk-3.0/noctalia.css
!.config/gtk-3.0/shadow-overrides.css
!.config/gtk-3.0/settings.ini
!.config/gtk-4.0/
!.config/gtk-4.0/gtk.css
!.config/gtk-4.0/gtk-dark.css
!.config/gtk-4.0/nautilus-overrides.css
!.config/gtk-4.0/noctalia.css
!.config/gtk-4.0/shadow-overrides.css
!.config/gtk-4.0/settings.ini
!.config/kitty/
!.config/kitty/kitty.conf
!.config/kitty/themes/
!.config/kitty/themes/noctalia.conf
!.config/wezterm/
!.config/wezterm/wezterm.lua
!.config/wezterm/colors/
!.config/wezterm/colors/Noctalia.toml
!.config/ferrosonic/
!.config/ferrosonic/themes/
!.config/ferrosonic/themes/noctalia.toml
!.config/systemd/
!.config/systemd/user/
!.config/systemd/user/hyprland-session.target
!.config/systemd/user/ps3-wave-wallpaper.service
!.config/systemd/user/noctalia.service
!.config/systemd/user/hyprshell.service
!.config/systemd/user/window-shader-events.service
!.config/systemd/user/localsend.service
!.config/systemd/user/wallpaper-session-effects.service
!.config/systemd/user/game-mode.service
!.local/share/
!.local/share/color-schemes/
!.local/share/color-schemes/noctalia.colors
!.local/share/session-sounds/
!.local/share/session-sounds/session-login.wav
!.local/share/session-sounds/session-logout.wav
!.local/
!.local/bin/
!.local/bin/dotfiles-install-wallpaper
!.local/bin/install-hyprwindowshade
!.local/bin/configure-localsend
!.local/bin/configure-localsend-firewall
!.local/bin/show-localsend
!.local/bin/gpu-screen-recorder-control
!.local/bin/install-gpu-screen-recorder
!.local/bin/configure-mission-center
!.local/bin/play-session-sound
