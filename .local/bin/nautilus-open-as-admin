#!/usr/bin/env bash

set -euo pipefail

if [[ "$#" -eq 0 ]]; then
    printf 'Usage: %s PATH...\n' "$0" >&2
    exit 2
fi

command -v nautilus >/dev/null 2>&1 || {
    printf 'nautilus is required to open an administrator location.\n' >&2
    exit 1
}

for path in "$@"; do
    [[ -e "$path" || -L "$path" ]] || {
        printf 'Skipping missing path: %s\n' "$path" >&2
        continue
    }

    admin_uri=$(python3 -c 'import pathlib, sys, urllib.parse; print("admin://" + urllib.parse.quote(str(pathlib.Path(sys.argv[1]).resolve()), safe="/:@"))' "$path")
    nautilus --new-window "$admin_uri" &
done

wait
