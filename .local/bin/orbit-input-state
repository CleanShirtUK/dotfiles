#!/usr/bin/env python3

import os
import select
import struct
import time
import tomllib
from pathlib import Path

try:
    import pyudev
except ImportError:
    pyudev = None


EVENT = struct.Struct("llHHi")
EV_KEY = 1
ALT_CODES = {56, 100}
runtime_dir = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
state_dir = os.path.join(runtime_dir, "orbit")
state_file = os.path.join(state_dir, "alt-held")
config_file = Path(os.environ.get("ORBIT_INPUT_DEVICES", os.path.expanduser("~/.config/orbit/input-devices.toml")))


def allowed_serials(path=config_file):
    try:
        values = tomllib.loads(path.read_text(encoding="utf-8"))
    except (OSError, tomllib.TOMLDecodeError):
        return set()
    return {
        item["serial"]
        for item in values.get("keyboard", [])
        if isinstance(item, dict) and isinstance(item.get("serial"), str) and item["serial"]
    }


def is_allowed_keyboard(device, serials):
    properties = device.properties
    node = device.device_node or ""
    return (
        properties.get("ID_INPUT_KEYBOARD") == "1"
        and os.path.basename(node).startswith("event")
        and properties.get("ID_SERIAL") in serials
    )


def write_state(held):
    os.makedirs(state_dir, mode=0o700, exist_ok=True)
    temporary = state_file + ".tmp"
    with open(temporary, "w", encoding="ascii") as stream:
        stream.write("1\n" if held else "0\n")
    os.replace(temporary, state_file)


def keyboard_devices():
    if pyudev is None:
        return
    serials = allowed_serials()
    if not serials:
        return
    context = pyudev.Context()
    for device in context.list_devices(subsystem="input"):
        if is_allowed_keyboard(device, serials):
            yield device.device_node


def main():
    if pyudev is None or not allowed_serials():
        write_state(False)
        raise SystemExit("orbit-input-state requires pyudev and a non-empty keyboard allowlist")
    handles = {}
    alt_keys = set()
    held = False
    write_state(False)

    while True:
        current_devices = set(keyboard_devices())
        for path in set(handles) - current_devices:
            handles.pop(path).close()
        for path in current_devices:
            if path in handles:
                continue
            try:
                handles[path] = open(path, "rb", buffering=0)
            except OSError:
                continue

        if not handles:
            time.sleep(1)
            continue

        readable, _, _ = select.select(list(handles.values()), [], [], 1)
        for stream in readable:
            try:
                payload = stream.read(EVENT.size)
            except OSError:
                payload = b""
            if len(payload) != EVENT.size:
                continue

            _, _, event_type, code, value = EVENT.unpack(payload)
            if event_type != EV_KEY or code not in ALT_CODES:
                continue
            if value == 1:
                alt_keys.add(code)
            elif value == 0:
                alt_keys.discard(code)
            next_held = bool(alt_keys)
            if next_held != held:
                held = next_held
                write_state(held)


if __name__ == "__main__":
    main()
