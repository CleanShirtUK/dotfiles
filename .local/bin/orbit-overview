#!/bin/sh

set -eu

state_dir="${XDG_CACHE_HOME:-$HOME/.cache}/orbit"
state_file="$state_dir/overview-visible"
obsolete_cycle_file="$state_dir/overview-cycle"
lock_file="$state_dir/overview.lock"
mkdir -p "$state_dir"
. "$HOME/.local/lib/orbit-state"
[ -e "$obsolete_cycle_file" ] && rm -f "$obsolete_cycle_file"

read_state() {
    state="closed 0 0"
    [ -f "$state_file" ] && state="$(tr -d '\n' < "$state_file")"
    set -- $state
    state_status="${1:-closed}"
    state_revision="${2:-0}"
    state_cycles="${3:-0}"
}

write_state() {
    orbit_state_write "$state_file" "$1 $2 $3"
}

lock_state() {
    orbit_state_lock "$lock_file"
}

case "${1:-open}" in
    open)
        lock_state
        read_state
        write_state open "$((state_revision + 1))" "$state_cycles"
        ;;
    close)
        lock_state
        read_state
        write_state closed "$((state_revision + 1))" "$state_cycles"
        ;;
    close-state)
        lock_state
        read_state
        write_state closed "$((state_revision + 1))" "$state_cycles"
        ;;
    activate)
        address="${2:-}"
        [ -n "$address" ] || exit 2
        hyprctl dispatch "hl.dsp.focus({ window = \"address:$address\" })" >/dev/null
        lock_state
        read_state
        write_state closed "$((state_revision + 1))"
        ;;
    workspace)
        workspace="${2:-}"
        [ -n "$workspace" ] || exit 2
        hyprctl dispatch "hl.dsp.focus({ workspace = \"$workspace\" })" >/dev/null
        ;;
    cycle)
        lock_state
        read_state
        if [ "$state_status" = open ]; then
            state_cycles=$((state_cycles + 1))
        fi
        write_state open "$((state_revision + 1))" "$state_cycles"
        ;;
    toggle)
        lock_state
        read_state
        if [ "$state_status" = open ]; then
            write_state closed "$((state_revision + 1))" "$state_cycles"
        else
            write_state open "$((state_revision + 1))" "$state_cycles"
        fi
        ;;
    *)
        printf 'Usage: %s {open|close|activate ADDRESS|workspace NAME|cycle|toggle}\n' "${0##*/}" >&2
        exit 2
        ;;
esac
