#!/bin/sh

set -eu

state_dir="${XDG_CACHE_HOME:-$HOME/.cache}/orbit"
state_file="$state_dir/xmb-visible"
overview_state_file="$state_dir/overview-visible"
shell_state_file="$state_dir/shell-visible"
mkdir -p "$state_dir"
[ -f "$state_file" ] || printf '0\n' > "$state_file"
[ -f "$overview_state_file" ] || printf 'closed 0 0\n' > "$overview_state_file"
[ -f "$shell_state_file" ] || printf '1\n' > "$shell_state_file"

overview="$HOME/.local/bin/orbit-overview"

# Orbit owns the Quick Controls visuals. Basic is a deterministic fallback for
# controls that have not yet been replaced by an Orbit component; Breeze is a
# Qt Widgets style and does not style Qt Quick Controls.
export QT_QUICK_CONTROLS_STYLE=Basic

for _ in $(seq 1 30); do
    if [ -n "${WAYLAND_DISPLAY:-}" ] && [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] && command -v hyprctl >/dev/null 2>&1; then
        break
    fi
    sleep 0.5
done

if [ -z "${WAYLAND_DISPLAY:-}" ] || [ -z "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
    printf 'Orbit requires a Hyprland Wayland session environment.\n' >&2
    exit 1
fi

# Hyprshell installs its switcher bindings at runtime rather than keeping
# them in the compositor configuration. Retry while the new compositor's
# control socket becomes ready instead of silently losing the bindings.
install_overview_bindings() {
    hyprctl eval 'hl.unbind("ALT + TAB")' >/dev/null 2>&1 \
        && hyprctl eval 'hl.unbind("Alt_L")' >/dev/null 2>&1 \
        && hyprctl eval 'hl.unbind("Alt_R")' >/dev/null 2>&1 \
        && hyprctl eval "hl.bind(\"ALT + TAB\", hl.dsp.exec_cmd(\"$overview cycle\"), { repeating = false })" >/dev/null 2>&1
}

bindings_ready() {
    hyprctl binds -j 2>/dev/null | python3 -c '
import json
import sys

try:
    bindings = json.load(sys.stdin)
except (json.JSONDecodeError, TypeError):
    raise SystemExit(1)

tab = [binding for binding in bindings if str(binding.get("key", "")).upper() == "TAB"]
legacy_release = [
    binding
    for binding in bindings
    if str(binding.get("key", "")).upper() in {"ALT_L", "ALT_R"}
    and binding.get("release")
]
ready = (
    len(tab) == 1
    and int(tab[0].get("modmask", 0)) & 8
    and tab[0].get("dispatcher") == "__lua"
    and not tab[0].get("repeat")
    and not tab[0].get("release")
    and not legacy_release
)
raise SystemExit(0 if ready else 1)
'
}

ensure_overview_bindings() {
    bindings_ready && return 0
    for _ in $(seq 1 60); do
        if install_overview_bindings && bindings_ready; then
            return 0
        fi
        sleep 0.5
    done
    return 1
}

if ! ensure_overview_bindings; then
    printf 'Orbit overview bindings were not installed; refusing to start the shell.\n' >&2
    exit 1
fi

shell_pid=
watchdog_pid=

cleanup() {
    if [ -n "$watchdog_pid" ]; then
        kill "$watchdog_pid" >/dev/null 2>&1 || true
        wait "$watchdog_pid" 2>/dev/null || true
    fi
}

terminate() {
    if [ -n "$shell_pid" ]; then
        kill "$shell_pid" >/dev/null 2>&1 || true
    fi
    exit 143
}

binding_watchdog() {
    while kill -0 "$shell_pid" >/dev/null 2>&1; do
        sleep 1
        kill -0 "$shell_pid" >/dev/null 2>&1 || return 0
        if ! bindings_ready && ! ensure_overview_bindings; then
            printf 'Orbit overview bindings were lost and could not be restored; stopping the shell.\n' >&2
            kill "$shell_pid" >/dev/null 2>&1 || true
            return 1
        fi
    done
}

trap cleanup EXIT
trap terminate HUP INT TERM

"$HOME/.local/bin/phleg-quickshell" --no-duplicate --path "$HOME/.config/quickshell/orbit/shell.qml" &
shell_pid=$!
binding_watchdog &
watchdog_pid=$!

shell_status=0
wait "$shell_pid" || shell_status=$?
exit "$shell_status"
