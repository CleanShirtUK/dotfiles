#!/usr/bin/env python3
"""Generate Orbit's canonical palette and toolkit adapter artifacts."""

from __future__ import annotations

import argparse
import json
import os
import re
import tempfile
import tomllib
from pathlib import Path


ORBIT = Path.home() / ".config/orbit"
SETTINGS = ORBIT / "settings.toml"
PALETTES = ORBIT / "palettes"
GENERATED = ORBIT / "generated"
GTK3_ACTIVE = Path.home() / ".config/gtk-3.0/noctalia.css"
GTK4_ACTIVE = Path.home() / ".config/gtk-4.0/noctalia.css"
KDE_SCHEME_ACTIVE = Path.home() / ".local/share/color-schemes/noctalia.colors"
HEX = re.compile(r"^#[0-9a-fA-F]{6}$")


def read_toml(path: Path) -> dict:
    with path.open("rb") as stream:
        return tomllib.load(stream)


def selected_palette() -> str:
    try:
        return str(read_toml(SETTINGS).get("theme", {}).get("palette", "tokyo-night"))
    except FileNotFoundError:
        return "tokyo-night"


def palette_path(name: str) -> Path:
    return PALETTES / (name if name.endswith(".toml") else f"{name}.toml")


def load_palette(name: str) -> tuple[str, dict, dict]:
    path = palette_path(name)
    try:
        config = read_toml(path)
    except FileNotFoundError as error:
        raise SystemExit(f"Unknown Orbit palette: {name}") from error

    palette = config.get("palette", {})
    colors = config.get("colors", {})
    missing = sorted(key for key in (
        "background", "background_deep", "surface", "surface_elevated",
        "surface_selected", "surface_highlight", "selection", "editor", "border", "border_strong", "split", "muted", "text",
        "text_muted", "accent", "accent_secondary", "accent_deep", "red",
        "green", "yellow", "orange", "cyan", "cyan_muted", "ansi_black",
        "ansi_white", "accent_foreground",
    ) if key not in colors)
    invalid = sorted(key for key, value in colors.items() if not HEX.fullmatch(str(value)))
    if missing:
        raise SystemExit(f"Palette {name} is missing colors: {', '.join(missing)}")
    if invalid:
        raise SystemExit(f"Palette {name} has invalid colors: {', '.join(invalid)}")
    return path.stem, palette, colors | {"gradients": config.get("gradients", {})}


def rgb(value: str) -> str:
    return f"rgb({value[1:]})"


def semantic(colors: dict) -> dict:
    return {
        "window_background": colors["background"],
        "background_deep": colors["background_deep"],
        "surface": colors["surface"],
        "surface_elevated": colors["surface_elevated"],
        "surface_selected": colors["surface_selected"],
        "surface_highlight": colors["surface_highlight"],
        "selection": colors["selection"],
        "editor": colors["editor"],
        "border": colors["border"],
        "border_strong": colors["border_strong"],
        "split": colors["split"],
        "muted": colors["muted"],
        "text": colors["text"],
        "text_muted": colors["text_muted"],
        "accent": colors["accent"],
        "accent_secondary": colors["accent_secondary"],
        "accent_deep": colors["accent_deep"],
        "error": colors["red"],
        "success": colors["green"],
        "warning": colors["yellow"],
        "orange": colors["orange"],
        "cyan": colors["cyan"],
        "cyan_muted": colors["cyan_muted"],
        "accent_foreground": colors["accent_foreground"],
    }


def gtk_css(values: dict, headerbar: str) -> str:
    lines = [
        "/* Generated by orbit-theme. Do not edit manually. */",
        f"@define-color accent_color {values['accent']};",
        f"@define-color accent_bg_color {values['accent']};",
        f"@define-color accent_fg_color {values['accent_foreground']};",
        f"@define-color destructive_bg_color {values['error']};",
        f"@define-color destructive_fg_color {values['accent_foreground']};",
        f"@define-color error_bg_color {values['error']};",
        f"@define-color error_fg_color {values['accent_foreground']};",
        f"@define-color window_bg_color {values['window_background']};",
        f"@define-color window_fg_color {values['text']};",
        f"@define-color view_bg_color {values['window_background']};",
        f"@define-color view_fg_color {values['text']};",
        f"@define-color headerbar_bg_color {headerbar};",
        f"@define-color headerbar_fg_color {values['text']};",
        "@define-color headerbar_backdrop_color @window_bg_color;",
        f"@define-color popover_bg_color {values['surface']};",
        f"@define-color popover_fg_color {values['text']};",
        f"@define-color card_bg_color {values['surface']};",
        f"@define-color card_fg_color {values['text']};",
        f"@define-color dialog_bg_color {values['window_background']};",
        f"@define-color dialog_fg_color {values['text']};",
        f"@define-color sidebar_bg_color {values['surface']};",
        f"@define-color sidebar_fg_color {values['text']};",
        f"@define-color secondary_sidebar_bg_color {values['window_background']};",
        f"@define-color secondary_sidebar_fg_color {values['text']};",
        f"@define-color overview_bg_color {values['surface']};",
        f"@define-color overview_fg_color {values['text']};",
        "@define-color theme_selected_bg_color @accent_bg_color;",
        "@define-color theme_selected_fg_color @accent_fg_color;",
        "@define-color theme_unfocused_fg_color @window_fg_color;",
        "@define-color theme_unfocused_text_color @view_fg_color;",
        "@define-color theme_unfocused_bg_color @window_bg_color;",
        "@define-color theme_unfocused_base_color @window_bg_color;",
        "@define-color theme_unfocused_selected_bg_color @accent_bg_color;",
        "@define-color theme_unfocused_selected_fg_color @accent_fg_color;",
        ":root {",
        f"    --accent-color: {values['accent']};",
        f"    --window-bg-color: {values['window_background']};",
        f"    --window-fg-color: {values['text']};",
        f"    --surface-color: {values['surface']};",
        f"    --surface-elevated-color: {values['surface_elevated']};",
        f"    --text-muted-color: {values['text_muted']};",
        f"    --error-color: {values['error']};",
        f"    --warning-color: {values['warning']};",
        f"    --warning-bg-color: {values['accent_deep']};",
        f"    --warning-fg-color: {values['text']};",
        f"    --success-color: {values['success']};",
        f"    --success-bg-color: {values['accent_deep']};",
        f"    --success-fg-color: {values['text']};",
        "}",
        "",
    ]
    return "\n".join(lines)


def hyprland_lua(values: dict) -> str:
    return f'''-- Generated by orbit-theme. Do not edit manually.
local primary = "{rgb(values["accent"])}"
local surface = "{rgb(values["window_background"])}"
local secondary = "{rgb(values["accent_secondary"])}"
local error = "{rgb(values["error"])}"

local function apply_theme()
    hl.config({{
        general = {{ col = {{ active_border = primary, inactive_border = surface }} }},
        group = {{
            col = {{
                border_active = secondary,
                border_inactive = surface,
                border_locked_active = error,
                border_locked_inactive = surface,
            }},
            groupbar = {{
                col = {{
                    active = secondary,
                    inactive = surface,
                    locked_active = error,
                    locked_inactive = surface,
                }},
            }},
        }},
    }})
end

return {{
    colors = {{ primary = primary, surface = surface, secondary = secondary, error = error }},
    apply_theme = apply_theme,
}}
'''


def kitty_conf(colors: dict) -> str:
    ansi = [colors[key] for key in ("ansi_black", "red", "green", "yellow", "accent", "accent_secondary", "cyan", "ansi_white")]
    bright = [colors["border_strong"], colors["red"], colors["green"], colors["yellow"], colors["accent"], colors["accent_secondary"], colors["cyan"], colors["text"]]
    lines = ["# Generated by orbit-theme. Do not edit manually."]
    lines += [f"color{index} {value}" for index, value in enumerate(ansi)]
    lines += [f"color{index + 8} {value}" for index, value in enumerate(bright)]
    lines += [
        f"cursor {colors['text']}",
        f"cursor_text_color {colors['background']}",
        f"background {colors['background']}",
        f"foreground {colors['text']}",
        f"selection_foreground {colors['text']}",
        f"selection_background {colors['selection']}",
        f"active_border_color {colors['accent']}",
        f"inactive_border_color {colors['border']}",
        f"url_color {colors['cyan']}",
    ]
    return "\n".join(lines) + "\n"


def wezterm_toml(colors: dict) -> str:
    ansi = [colors[key] for key in ("ansi_black", "red", "green", "yellow", "accent", "accent_secondary", "cyan", "ansi_white")]
    bright = [colors["border_strong"], colors["red"], colors["green"], colors["yellow"], colors["accent"], colors["accent_secondary"], colors["cyan"], colors["text"]]

    def array(values: list[str]) -> str:
        return "[\n" + "".join(f'    "{value}",\n' for value in values) + "]"

    return f'''# Generated by orbit-theme. Do not edit manually.
[colors]
ansi = {array(ansi)}
background = "{colors['background']}"
brights = {array(bright)}
compose_cursor = "{colors['text']}"
cursor_bg = "{colors['text']}"
cursor_border = "{colors['text']}"
cursor_fg = "{colors['background']}"
foreground = "{colors['text']}"
selection_bg = "{colors['selection']}"
selection_fg = "{colors['text']}"
split = "{colors['split']}"
visual_bell = "{colors['ansi_black']}"

[colors.indexed]
16 = "{colors['accent_secondary']}"
17 = "{colors['text']}"
'''


def ferrosonic_toml(colors: dict, gradients: dict) -> str:
    gradient = gradients.get("cava", [])
    horizontal = gradients.get("horizontal_cava", [])
    def array(values: list[str]) -> str:
        return "[" + ", ".join(f'"{value}"' for value in values) + "]"
    return f'''# Generated by orbit-theme. Do not edit manually.
[colors]
primary = "{colors['accent']}"
secondary = "{colors['accent_deep']}"
accent = "{colors['yellow']}"
artist = "{colors['green']}"
album = "{colors['accent_secondary']}"
song = "{colors['cyan']}"
muted = "{colors['muted']}"
highlight_bg = "{colors['surface_highlight']}"
highlight_fg = "{colors['text']}"
success = "{colors['green']}"
error = "{colors['red']}"
playing = "{colors['yellow']}"
played = "{colors['muted']}"
border_focused = "{colors['accent']}"
border_unfocused = "{colors['surface_highlight']}"

[cava]
gradient = {array(gradient)}
horizontal_gradient = {array(horizontal)}
'''


def write_atomic(path: Path, content: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile("w", dir=path.parent, delete=False) as stream:
        stream.write(content)
        temporary = Path(stream.name)
    os.replace(temporary, path)


def generate(name: str) -> Path:
    palette_name, metadata, colors = load_palette(name)
    values = semantic(colors)
    output = GENERATED / palette_name
    output.mkdir(parents=True, exist_ok=True)
    write_atomic(output / "semantic.json", json.dumps({"palette": metadata, "colors": colors, "semantic": values}, indent=2) + "\n")
    write_atomic(output / "quickshell.json", json.dumps(values, indent=2) + "\n")
    write_atomic(output / "gtk-3.0.css", gtk_css(values, values["surface"]))
    write_atomic(output / "gtk-4.0.css", gtk_css(values, values["window_background"]))
    write_atomic(output / "hyprland.lua", hyprland_lua(values))
    write_atomic(output / "kitty.conf", kitty_conf(colors))
    write_atomic(output / "wezterm.toml", wezterm_toml(colors))
    write_atomic(output / "ferrosonic.toml", ferrosonic_toml(colors, colors["gradients"]))
    print(output)
    return output


def kde_scheme(values: dict) -> str:
    def rgb(value: str) -> str:
        return ",".join(str(int(value[index:index + 2], 16)) for index in (1, 3, 5))

    background = rgb(values["window_background"])
    surface = rgb(values["surface"])
    elevated = rgb(values["surface_elevated"])
    accent = rgb(values["accent"])
    text = rgb(values["text"])
    muted = rgb(values["text_muted"])
    error = rgb(values["error"])
    success = rgb(values["success"])
    secondary = rgb(values["accent_secondary"])
    selected_text = rgb(values["accent_foreground"])
    return f'''[KDE]
contrast=4

[General]
ColorScheme=Noctalia
Name=noctalia

[Colors:Button]
BackgroundAlternate={rgb(values["background_deep"])}
BackgroundNormal={surface}
DecorationFocus={accent}
DecorationHover={accent}
ForegroundActive={accent}
ForegroundInactive={muted}
ForegroundLink={secondary}
ForegroundNegative={error}
ForegroundNeutral={success}
ForegroundNormal={text}
ForegroundPositive={success}
ForegroundVisited={secondary}

[Colors:Complementary]
BackgroundAlternate={rgb(values["editor"])}
BackgroundNormal={background}
DecorationFocus={accent}
DecorationHover={accent}
ForegroundActive={accent}
ForegroundInactive={muted}
ForegroundLink={secondary}
ForegroundNegative={error}
ForegroundNeutral={success}
ForegroundNormal={text}
ForegroundPositive={success}
ForegroundVisited={secondary}

[Colors:Header]
BackgroundAlternate={background}
BackgroundNormal={surface}
DecorationFocus={accent}
DecorationHover={accent}
ForegroundActive={accent}
ForegroundInactive={muted}
ForegroundLink={secondary}
ForegroundNegative={error}
ForegroundNeutral={success}
ForegroundNormal={text}
ForegroundPositive={success}
ForegroundVisited={secondary}

[Colors:Selection]
BackgroundAlternate={rgb(values["background_deep"])}
BackgroundNormal={accent}
DecorationFocus={accent}
DecorationHover={accent}
ForegroundActive={selected_text}
ForegroundInactive={muted}
ForegroundLink={secondary}
ForegroundNegative={error}
ForegroundNeutral={success}
ForegroundNormal={selected_text}
ForegroundPositive={success}
ForegroundVisited={secondary}

[Colors:View]
BackgroundAlternate={surface}
BackgroundNormal={background}
DecorationFocus={rgb(values["border_strong"])}
DecorationHover={selected_text}
ForegroundActive={accent}
ForegroundInactive={muted}
ForegroundLink={secondary}
ForegroundNegative={error}
ForegroundNeutral={success}
ForegroundNormal={text}
ForegroundPositive={success}
ForegroundVisited={secondary}

[Colors:Window]
BackgroundAlternate={background}
BackgroundNormal={surface}
DecorationFocus={accent}
DecorationHover={accent}
ForegroundActive={accent}
ForegroundInactive={muted}
ForegroundLink={secondary}
ForegroundNegative={error}
ForegroundNeutral={success}
ForegroundNormal={text}
ForegroundPositive={success}
ForegroundVisited={secondary}

[WM]
activeBackground={accent}
activeBlend={text}
activeForeground={text}
inactiveBackground={background}
inactiveBlend={muted}
inactiveForeground={muted}
'''


def install_active_adapters(palette_name: str) -> None:
    generated = GENERATED / palette_name
    write_atomic(GTK3_ACTIVE, (generated / "gtk-3.0.css").read_text())
    write_atomic(GTK4_ACTIVE, (generated / "gtk-4.0.css").read_text())
    semantic_values = json.loads((generated / "semantic.json").read_text())["semantic"]
    write_atomic(KDE_SCHEME_ACTIVE, kde_scheme(semantic_values))


def main() -> None:
    parser = argparse.ArgumentParser(prog="orbit-theme")
    subparsers = parser.add_subparsers(dest="command", required=True)
    subparsers.add_parser("current", help="print the selected palette")
    subparsers.add_parser("list", help="list available palettes")
    generate_command = subparsers.add_parser("generate", help="generate toolkit adapters")
    generate_command.add_argument("palette", nargs="?", default=None)
    apply_command = subparsers.add_parser("apply", help="select and generate a palette")
    apply_command.add_argument("palette")
    args = parser.parse_args()

    if args.command == "current":
        print(selected_palette())
    elif args.command == "list":
        for path in sorted(PALETTES.glob("*.toml")):
            print(path.stem)
    elif args.command == "generate":
        generate(args.palette or selected_palette())
    elif args.command == "apply":
        palette = palette_path(args.palette)
        if not palette.is_file():
            raise SystemExit(f"Unknown Orbit palette: {args.palette}")
        settings = read_toml(SETTINGS) if SETTINGS.exists() else {}
        settings_text = SETTINGS.read_text() if SETTINGS.exists() else ""
        if "[theme]" not in settings_text:
            settings_text = settings_text.rstrip() + f"\n\n[theme]\npalette = \"{palette.stem}\"\n"
        else:
            settings_text = re.sub(r'(?m)^palette\s*=\s*"[^"]+"$', f'palette = "{palette.stem}"', settings_text)
        write_atomic(SETTINGS, settings_text)
        generate(palette.stem)
        install_active_adapters(palette.stem)


if __name__ == "__main__":
    main()
