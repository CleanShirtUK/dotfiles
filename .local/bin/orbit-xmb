#!/bin/sh

set -eu

state_dir="${XDG_CACHE_HOME:-$HOME/.cache}/orbit"
state_file="$state_dir/xmb-visible"
lock_file="$state_dir/xmb.lock"
mkdir -p "$state_dir"
. "$HOME/.local/lib/orbit-state"

write_state() {
    orbit_state_write "$state_file" "$1"
}

case "${1:-toggle}" in
    open)
        orbit_state_lock "$lock_file"
        write_state 1
        ;;
    close)
        orbit_state_lock "$lock_file"
        write_state 0
        ;;
    toggle)
        orbit_state_lock "$lock_file"
        current=0
        [ -f "$state_file" ] && current="$(tr -d '[:space:]' < "$state_file")"
        if [ "$current" = 1 ]; then
            write_state 0
        else
            write_state 1
        fi
        ;;
    *)
        printf 'Usage: %s {open|close|toggle}\n' "${0##*/}" >&2
        exit 2
        ;;
esac
